# GITHUB_TOKEN: Optional. Required only to display the contribution calendar
# in the GitHub app. Create a classic PAT with `read:user` scope at:
# https://github.com/settings/tokens
GITHUB_TOKEN=""

# ROBLOX: Required for the Roblox app (profile, game stats, contributed visits).
# ROBLOX_USER_ID — Your numeric Roblox user ID (visible in your profile URL).
# MINIMUM_RANK_REQUIRED — Minimum group rank to be considered an active contributor.
#   Groups where your rank is below this value are excluded from the visit count.
#   Default: 189. Lower this value to include more groups; raise it to be stricter.
ROBLOX_USER_ID=""
MINIMUM_RANK_REQUIRED="189"

# AUTH: Required for GitHub sign-in (blog comments + linking a GitHub
# profile to a visitor star).
# Step 1 — Create a GitHub OAuth App at https://github.com/settings/developers
#           Homepage URL: your site's URL (e.g. http://localhost:3000 for dev)
#           Callback URL: <site>/api/auth/callback/github
# Step 2 — Grab the Client ID and generate a Client Secret from that app's page.
# Step 3 — AUTH_SECRET is a random string used to encrypt session tokens —
#           generate one with `openssl rand -base64 32`.
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""
AUTH_SECRET=""
# NEXTAUTH_URL: the canonical URL of the site, used to build OAuth callback
# URLs. Set to http://localhost:3000 locally; on Netlify, set it to the
# deployed site's URL.
NEXTAUTH_URL="http://localhost:3000"
